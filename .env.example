# Copie para .env e ajuste. NUNCA versione o .env.

# --- Segurança -------------------------------------------------------------
# Gere uma chave nova com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar esta chave invalida todas as sessões e todos os links de download ativos.
SECRET_KEY=troque-esta-chave-em-producao
TOKEN_EXPIRA_MINUTOS=720

# Primeiro acesso. Sem ADMIN_SENHA, uma senha aleatória é gerada e impressa
# uma única vez no console na primeira inicialização.
ADMIN_EMAIL=admin@treele.com.br
# ADMIN_SENHA=

# --- Banco -----------------------------------------------------------------
# Sem esta variável, usa SQLite em backend/data/treele.db (só para desenvolvimento).
# DATABASE_URL=postgresql+psycopg://treele:senha@db:5432/treele

# --- Armazenamento ---------------------------------------------------------
# local = grava em disco, URLs assinadas pela própria API (desenvolvimento)
# s3    = MinIO, S3, Cloudflare R2 ou Backblaze B2 (produção)
STORAGE_BACKEND=local

# S3_ENDPOINT=http://localhost:9000        # público: quem abre é o navegador
# S3_ENDPOINT_INTERNO=http://minio:9000    # interno: quem chama é a própria API
# S3_BUCKET=treele-projetos
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

URL_EXPIRA_SEGUNDOS=3600
TAMANHO_MAX_MB=2048

# --- Endereços -------------------------------------------------------------
# BASE_URL é o endereço público da API — entra nos links de download assinados.
BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
AMBIENTE=dev
