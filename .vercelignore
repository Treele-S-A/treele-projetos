# O que NUNCA sai deste computador para a Vercel.
#
# No deploy pelo GitHub quase nada disto chega lá, porque não está no
# repositório. Mas um deploy pela linha de comando (vercel deploy) sobe a pasta
# como ela está — com senhas locais e anotações de credencial junto.

# Segredos
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
cloudfare/

# Ambiente e dados locais
backend/.venv/
backend/data/
**/.pytest_cache/
**/__pycache__/
frontend/node_modules/
frontend/dist/
.claude/
.vercel/
